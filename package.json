{
  "name": "evictl",
  "version": "0.1.0",
  "description": "Orchestrate local evi agent runtimes and shared memory",
  "keywords": [
    "agent",
    "claude",
    "hermes-agent",
    "openclaw",
    "orchestration",
    "telegram"
  ],
  "homepage": "https://github.com/schroneko/evictl#readme",
  "bugs": {
    "url": "https://github.com/schroneko/evictl/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schroneko/evictl.git"
  },
  "bin": {
    "evictl": "bin/evictl"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "profiles",
    "README.md",
    "README.ja.md",
    "docs",
    "LICENSE",
    "SECURITY.md"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit && bun run lint:text",
    "test": "bun test",
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/evictl",
    "lint:text": "textlint \"README.md\" \"README.ja.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"profiles/*/README.md\"",
    "lint:text:fix": "textlint --fix \"README.md\" \"README.ja.md\" \"docs/**/*.md\" \"skills/**/*.md\" \"profiles/*/README.md\"",
    "prepack": "bun test && bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "textlint": "^15.7.1",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.13"
}
